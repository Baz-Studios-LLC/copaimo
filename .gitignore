# Rust build output
/target

# Hand-sculpted terrain (assets/world/edits.bin) is NOT ignored on purpose —
# it's authored content, not build output, and syncing it between machines is
# the whole reason this repo exists. It compresses well despite its size, being
# mostly zeros.

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Scripted figures build their own .blend from dev/art/*.py, so the .blend is
# an intermediate. Once one is taken over by hand in Blender, commit it and
# delete the script that made it — a generator and a hand-edited file cannot
# both be the source of truth.
/dev/art/*.blend
/cover_patch.ply
